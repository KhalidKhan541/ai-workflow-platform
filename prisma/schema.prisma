generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgVector(map: "vector")]
  schemas    = ["public", "auth"]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
  ERROR
}

enum TriggerType {
  WEBHOOK
  SCHEDULE
  EVENT
  MANUAL
  API
}

enum ActionType {
  HTTP_REQUEST
  AI_COMPLETION
  DATA_TRANSFORM
  SEND_EMAIL
  UPDATE_RECORD
  CONDITION
  WAIT
  CUSTOM_CODE
}

enum ExecutionStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum IntegrationType {
  SLACK
  GITHUB
  JIRA
  HUBSPOT
  SALESFORCE
  STRIPE
  SENDGRID
  TWILIO
  AWS
  CUSTOM
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  EXECUTE
  SHARE
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
  WORKFLOW_COMPLETE
  WORKFLOW_FAILED
  INTEGRATION_ERROR
  USAGE_ALERT
  BILLING
}

enum DataRecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  DELETED
}

enum WebhookStatus {
  ACTIVE
  INACTIVE
  FAILED
}

enum APIKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// ============ AUTH MODELS ============

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip           String?
  userAgent    String?

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  isActive      Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?

  accounts       Account[]
  sessions       Session[]
  memberships    OrgMember[]
  ownedOrgs      Organization[]
  workflows      Workflow[]
  executions     Execution[]
  apiKeys        APIKey[]
  webhooks       Webhook[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  subscriptions  Subscription[]
  usageMetrics   UsageMetric[]
  aiRuns         AIRun[]

  @@index([email])
  @@index([isActive, isDeleted])
}

// ============ ORGANIZATION MODELS ============

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  settings    Json?
  metadata    Json?

  owner         User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members       OrgMember[]
  workflows     Workflow[]
  integrations  Integration[]
  dataSources   DataSource[]
  apiKeys       APIKey[]
  webhooks      Webhook[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]
  usageMetrics  UsageMetric[]

  @@index([slug])
  @@index([ownerId])
  @@index([isDeleted])
}

model OrgMember {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  invitedBy      String?
  acceptedAt     DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
}

// ============ WORKFLOW MODELS ============

model Workflow {
  id              String         @id @default(cuid())
  name            String
  description     String?        @db.Text
  organizationId  String
  createdBy       String
  status          WorkflowStatus @default(DRAFT)
  version         Int            @default(1)
  config          Json?
  tags            String[]
  isTemplate      Boolean        @default(false)
  isPublished     Boolean        @default(false)
  scheduleCron    String?
  timeoutMs       Int            @default(300000)
  retryCount      Int            @default(3)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lastRunAt       DateTime?
  runCount        Int            @default(0)
  isDeleted       Boolean        @default(false)
  deletedAt       DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User            @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  steps        WorkflowStep[]
  triggers     WorkflowTrigger[]
  actions      WorkflowAction[]
  executions   Execution[]

  @@index([organizationId])
  @@index([createdBy])
  @@index([status])
  @@index([isTemplate])
  @@index([isDeleted])
  @@index([organizationId, status])
}

model WorkflowStep {
  id          String   @id @default(cuid())
  workflowId  String
  name        String
  type        String
  config      Json
  order       Int
  parentId    String?
  x           Float    @default(0)
  y           Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workflow Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  parent   WorkflowStep?    @relation("StepHierarchy", fields: [parentId], references: [id])
  children WorkflowStep[]   @relation("StepHierarchy")
  actions  WorkflowAction[]

  @@index([workflowId])
  @@index([parentId])
  @@index([workflowId, order])
}

model WorkflowTrigger {
  id          String      @id @default(cuid())
  workflowId  String
  type        TriggerType
  config      Json
  isActive    Boolean     @default(true)
  lastTriggeredAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([type])
  @@index([isActive])
}

model WorkflowAction {
  id          String     @id @default(cuid())
  workflowId  String
  stepId      String?
  type        ActionType
  name        String
  config      Json
  order       Int        @default(0)
  condition   Json?
  timeoutMs   Int?
  retryPolicy Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workflow Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  step     WorkflowStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([workflowId])
  @@index([stepId])
  @@index([type])
}

// ============ EXECUTION MODELS ============

model Execution {
  id          String          @id @default(cuid())
  workflowId  String
  userId      String?
  status      ExecutionStatus @default(PENDING)
  triggerData Json?
  result      Json?
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  durationMs  Int?
  runNumber   Int             @default(1)
  isDeleted   Boolean         @default(false)
  metadata    Json?

  workflow  Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  logs      ExecutionLog[]
  errors    ExecutionError[]

  @@index([workflowId])
  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@index([workflowId, status])
}

model ExecutionLog {
  id          String   @id @default(cuid())
  executionId String
  stepId      String?
  level       String   @default("info")
  message     String   @db.Text
  data        Json?
  durationMs  Int?
  createdAt   DateTime @default(now())

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([level])
  @@index([createdAt])
}

model ExecutionError {
  id          String   @id @default(cuid())
  executionId String
  stepId      String?
  code        String
  message     String   @db.Text
  stack       String?  @db.Text
  context     Json?
  createdAt   DateTime @default(now())

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([code])
}

// ============ INTEGRATION MODELS ============

model Integration {
  id              String          @id @default(cuid())
  organizationId  String
  name            String
  type            IntegrationType
  description     String?
  config          Json
  credentials     Json
  isActive        Boolean         @default(true)
  lastSyncAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  isDeleted       Boolean         @default(false)
  deletedAt       DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  configs      IntegrationConfig[]

  @@index([organizationId])
  @@index([type])
  @@index([isActive])
}

model IntegrationConfig {
  id            String      @id @default(cuid())
  integrationId String
  key           String
  value         Json
  isSecret      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, key])
  @@index([integrationId])
}

// ============ AI MODELS ============

model AIAgent {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text
  model           String   @default("gpt-4")
  systemPrompt    String?  @db.Text
  temperature     Float    @default(0.7)
  maxTokens       Int      @default(4096)
  config          Json?
  organizationId  String?
  createdBy       String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?

  prompts AIPrompt[]
  runs    AIRun[]

  @@index([organizationId])
  @@index([createdBy])
  @@index([model])
}

model AIPrompt {
  id        String   @id @default(cuid())
  agentId   String
  name      String
  template  String   @db.Text
  variables Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent AIAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model AIRun {
  id         String   @id @default(cuid())
  agentId    String
  userId     String
  promptId   String?
  input      Json
  output     Json?
  model      String
  tokensUsed Int?
  costCents  Int?
  latencyMs  Int?
  status     String   @default("pending")
  error      String?  @db.Text
  createdAt  DateTime @default(now())
  completedAt DateTime?

  agent  AIAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

// ============ DATA MODELS ============

model DataSource {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  type           String
  config         Json
  schemaId       String?
  isActive       Boolean  @default(true)
  lastSyncAt     DateTime?
  recordCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isDeleted      Boolean  @default(false)
  deletedAt      DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schema       DataSchema?    @relation(fields: [schemaId], references: [id], onDelete: SetNull)
  records      DataRecord[]

  @@index([organizationId])
  @@index([type])
  @@index([isActive])
}

model DataSchema {
  id        String       @id @default(cuid())
  name      String
  version   String       @default("1.0.0")
  fields    Json
  indexes   Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  sources DataSource[]

  @@index([name])
}

model DataRecord {
  id           String           @id @default(cuid())
  dataSourceId String
  externalId   String?
  data         Json
  embeddings   Unsupported("vector(1536)")?
  status       DataRecordStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  expiresAt    DateTime?

  dataSource DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@index([dataSourceId])
  @@index([externalId])
  @@index([status])
  @@index([createdAt])
}

// ============ WEBHOOK & API MODELS ============

model Webhook {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  name           String
  url            String
  secret         String
  events         String[]
  status         WebhookStatus @default(ACTIVE)
  lastTriggeredAt DateTime?
  failureCount   Int           @default(0)
  config         Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  isDeleted      Boolean       @default(false)
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([events])
}

model APIKey {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  name           String
  key            String        @unique
  keyPrefix      String
  scopes         String[]
  status         APIKeyStatus  @default(ACTIVE)
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  usageCount     Int           @default(0)
  rateLimit      Int           @default(1000)
  createdAt      DateTime      @default(now())
  isDeleted      Boolean       @default(false)
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([key])
  @@index([status])
}

// ============ AUDIT & NOTIFICATION MODELS ============

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  userId         String?
  action         AuditAction
  resourceType   String
  resourceId     String?
  details        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
  @@index([organizationId, action, createdAt])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  type           NotificationType
  title          String
  message        String           @db.Text
  data           Json?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

// ============ BILLING MODELS ============

model Subscription {
  id              String           @id @default(cuid())
  organizationId  String
  userId          String
  stripeId        String?          @unique
  stripeCustomerId String?
  plan            SubscriptionPlan @default(FREE)
  status          String           @default("active")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAt        DateTime?
  canceledAt      DateTime?
  trialEndsAt     DateTime?
  monthlyExecQuota Int             @default(100)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([stripeId])
  @@index([plan, status])
}

model UsageMetric {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String?
  metricType      String
  quantity        Int      @default(0)
  periodStart     DateTime
  periodEnd       DateTime
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([metricType])
  @@index([periodStart, periodEnd])
  @@index([organizationId, metricType, periodStart])
}
