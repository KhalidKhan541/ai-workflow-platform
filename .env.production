# ==========================================
# PRODUCTION ENVIRONMENT
# ==========================================
# IMPORTANT: This file is a template. Copy to .env.production.local
# and fill in real values. Never commit real secrets.

NODE_ENV=production

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/aiworkflow?schema=public

# ==========================================
# REDIS
# ==========================================
REDIS_URL=redis://CHANGE_ME:6379

# ==========================================
# AUTHENTICATION
# ==========================================
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
NEXTAUTH_URL=https://app.yourdomain.com

# ==========================================
# AI SERVICES
# ==========================================
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=gpt-4

# ==========================================
# EMAIL
# ==========================================
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=CHANGE_ME
EMAIL_FROM=noreply@yourdomain.com

# ==========================================
# FILE STORAGE
# ==========================================
S3_BUCKET=aiworkflow-prod
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# ==========================================
# WEBHOOKS
# ==========================================
WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# ==========================================
# MONITORING
# ==========================================
SENTRY_DSN=https://CHANGE_ME@o000000.ingest.sentry.io/0000000

# ==========================================
# WORKER
# ==========================================
WORKER_CONCURRENCY=10
