# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_workflow_platform?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-minimum-32-characters-long"

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"

# Stripe
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email (optional)
RESEND_API_KEY="re_your-resend-api-key"

# App
APP_NAME="AI Workflow Platform"
APP_DESCRIPTION="Enterprise Workflow Automation"
NODE_ENV="development"

# Logging
LOG_LEVEL="debug"

# Session
SESSION_MAX_AGE=2592000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# AI
AI_DEFAULT_MODEL="gpt-4"
AI_MAX_TOKENS=4096

# Security
ALLOWED_ORIGINS="http://localhost:3000"
ENCRYPTION_KEY="your-encryption-key-minimum-32-characters"

# Upload
MAX_FILE_SIZE_MB=10

# Skip env validation (development only)
NEXT_PUBLIC_SKIP_ENV_VALIDATION=false
